@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;1,400&display=swap");
@import "tailwindcss";

@theme {
  --color-ink: #1a1a1a;
  --color-cream: #f6eee3;
  --color-gold: #b8860b;
  --color-deep-gold: #9c6b12;
  --color-warm-grey: #6b6b6b;
  --color-hairline: #d9cfbe;
  --color-white: #ffffff;

  --font-sans: Inter, system-ui, sans-serif;
  --font-serif: "Playfair Display", Georgia, serif;

  --radius-card: 14px;
  --radius-button: 8px;

  --shadow-card-hover: 0 12px 24px rgba(26, 26, 26, 0.08);

  --text-display-desktop: 60px;
  --text-display-mobile: 34px;
  --text-section-desktop: 34px;
  --text-section-mobile: 24px;
  --text-eyebrow-desktop: 13px;
  --text-eyebrow-mobile: 11px;
  --text-body-desktop: 16px;
  --text-body-mobile: 15px;
  --text-nav: 15px;
  --text-price-desktop: 16px;
  --text-price-mobile: 15px;
  --text-button: 15px;
  --text-caption: 13px;
  --text-caption-mobile: 12px;

  --breakpoint-*: initial;
  --breakpoint-tablet: 40.0625rem;
  --breakpoint-desktop: 64.0625rem;
}

:root {
  color-scheme: light;
  --section-padding-desktop: 80px;
  --section-padding-mobile: 44px;
  --grid-gutter-desktop: 24px;
  --grid-gutter-mobile: 16px;
  --content-max-width: 1280px;
}

* {
  box-sizing: border-box;
}

html {
  background: #f6eee3;
  scroll-behavior: auto;
}

body {
  margin: 0;
  background: #f6eee3;
  color: #1a1a1a;
  font-family: Inter, system-ui, sans-serif;
  font-size: 15px;
  line-height: 1.5;
}

button,
input,
textarea,
select {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

img,
picture,
svg {
  display: block;
}

::selection {
  background: #b8860b;
  color: #ffffff;
}

.site-container {
  width: min(calc(100% - 32px), var(--content-max-width));
  margin-inline: auto;
}

.section-shell {
  padding-block: var(--section-padding-mobile);
}

.wa-display {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 34px;
  font-weight: 400;
  line-height: 1.1;
}

.wa-section-heading {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 24px;
  font-weight: 400;
  line-height: 1.2;
}

.wa-eyebrow {
  color: #b8860b;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 1.4;
  text-transform: uppercase;
}

.wa-body {
  font-size: 15px;
  font-weight: 400;
  line-height: 1.5;
}

.wa-caption {
  font-size: 12px;
  font-weight: 400;
  line-height: 1.5;
}

.utility-link,
.footer-link {
  color: inherit;
  text-decoration: none;
}

.utility-link:hover,
.utility-link:focus-visible,
.footer-link:hover,
.footer-link:focus-visible {
  color: #b8860b;
}

.icon-link,
.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #1a1a1a;
  text-decoration: none;
}

.icon-link:hover,
.icon-link:focus-visible,
.icon-button:hover,
.icon-button:focus-visible {
  color: #b8860b;
  outline: none;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-width: 96px;
  border-bottom: 2px solid transparent;
  padding-inline: 12px;
  color: #1a1a1a;
  font-size: 15px;
  font-weight: 500;
  line-height: 1;
  text-decoration: none;
}

.nav-link:hover,
.nav-link:focus-visible {
  color: #b8860b;
  outline: none;
}

.nav-link[aria-current="page"] {
  border-bottom-color: #b8860b;
  color: #b8860b;
}

.mobile-nav-link {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #d9cfbe;
  color: #1a1a1a;
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
}

.mobile-nav-link:hover,
.mobile-nav-link:focus-visible {
  color: #b8860b;
  outline: none;
}

.button-primary,
.button-secondary {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1;
}

.button-primary {
  border: 1px solid #b8860b;
  background: #b8860b;
  color: #ffffff;
}

.button-primary:hover,
.button-primary:focus-visible {
  border-color: #9c6b12;
  background: #9c6b12;
  outline: none;
}

.button-primary:disabled {
  cursor: default;
  border-color: #d9cfbe;
  background: #d9cfbe;
  color: #6b6b6b;
}

.button-secondary {
  border: 1px solid #1a1a1a;
  background: transparent;
  color: #1a1a1a;
}

.button-secondary:hover,
.button-secondary:focus-visible {
  background: #1a1a1a;
  color: #ffffff;
  outline: none;
}

.button-secondary:disabled {
  cursor: default;
  border-color: #d9cfbe;
  color: #6b6b6b;
}

.input-field {
  min-height: 44px;
  border: 1px solid #d9cfbe;
  border-radius: 8px;
  background: #ffffff;
  padding: 10px 12px;
  color: #1a1a1a;
  outline: none;
}

.input-field:focus {
  border-color: #b8860b;
}

.input-field:disabled {
  cursor: default;
  border-color: #d9cfbe;
  background: #f0ebe0;
  color: #6b6b6b;
}

.card-surface {
  overflow: hidden;
  border: 1px solid #d9cfbe;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: none;
}

.footer-link {
  color: rgba(255, 255, 255, 0.65);
  font-size: 13px;
  line-height: 1.5;
}

.social-link {
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 8px;
  color: #ffffff;
}

.social-link:hover,
.social-link:focus-visible {
  border-color: #b8860b;
  color: #b8860b;
  outline: none;
}

@media (min-width: 40.0625rem) {
  body {
    font-size: 16px;
    line-height: 1.6;
  }

  .site-container {
    width: min(calc(100% - 48px), var(--content-max-width));
  }

  .section-shell {
    padding-block: var(--section-padding-desktop);
  }

  .wa-display {
    font-size: 60px;
    line-height: 1.05;
  }

  .wa-section-heading {
    font-size: 34px;
  }

  .wa-eyebrow {
    font-size: 13px;
  }

  .wa-body {
    font-size: 16px;
    line-height: 1.6;
  }

  .wa-caption {
    font-size: 13px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}
