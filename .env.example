NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Keep test locally. Change to live only on the production Vercel deployment.
NEXT_PUBLIC_DATA_MODE=test
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_PAYSTACK_CURRENCY=NGN

# The only email allowed to claim the private owner dashboard
ADMIN_OWNER_EMAIL=owner@example.com

# Phase 8F — private vendor notifications
# Business email alerts are sent through Brevo's transactional email API.
VENDOR_NOTIFICATION_EMAIL=orders@itsamazing.com.ng
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=no-reply@itsamazing.com.ng
BREVO_SENDER_NAME=Wow & Amazing

# WhatsApp alerts are sent through the official Twilio WhatsApp API.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# Sandbox example: +14155238886. Production: your registered WhatsApp sender.
TWILIO_WHATSAPP_FROM=+14155238886
VENDOR_WHATSAPP_TO=+234YOUR_OWNER_NUMBER
# Production template mode (recommended outside the 24-hour service window).
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Keep false locally; use the notification-centre Test buttons instead.
NOTIFY_TEST_DATA=false
